{
  "$id": "https://atd.dev/schema/v1.0.0/atd-protocol-schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "AtdError": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "ToolNotFound": {
              "properties": {
                "suggestions": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "tool_id": {
                  "type": "string"
                }
              },
              "required": [
                "suggestions",
                "tool_id"
              ],
              "type": "object"
            }
          },
          "required": [
            "ToolNotFound"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "InvalidArguments": {
              "properties": {
                "field": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "tool_id": {
                  "type": "string"
                }
              },
              "required": [
                "field",
                "reason",
                "tool_id"
              ],
              "type": "object"
            }
          },
          "required": [
            "InvalidArguments"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "CapabilityDenied": {
              "properties": {
                "granted": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "required": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "tool_id": {
                  "type": "string"
                }
              },
              "required": [
                "granted",
                "required",
                "tool_id"
              ],
              "type": "object"
            }
          },
          "required": [
            "CapabilityDenied"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "BindingUnavailable": {
              "properties": {
                "reason": {
                  "type": "string"
                },
                "tool_id": {
                  "type": "string"
                },
                "tried": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "required": [
                "reason",
                "tool_id",
                "tried"
              ],
              "type": "object"
            }
          },
          "required": [
            "BindingUnavailable"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Timeout": {
              "properties": {
                "after_ms": {
                  "format": "uint64",
                  "minimum": 0.0,
                  "type": "integer"
                },
                "tool_id": {
                  "type": "string"
                }
              },
              "required": [
                "after_ms",
                "tool_id"
              ],
              "type": "object"
            }
          },
          "required": [
            "Timeout"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "NotImplemented": {
              "properties": {
                "feature": {
                  "type": "string"
                }
              },
              "required": [
                "feature"
              ],
              "type": "object"
            }
          },
          "required": [
            "NotImplemented"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "ProtocolError": {
              "properties": {
                "expected": {
                  "type": "string"
                },
                "got": {
                  "type": "string"
                }
              },
              "required": [
                "expected",
                "got"
              ],
              "type": "object"
            }
          },
          "required": [
            "ProtocolError"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "SP-pagination-v1 §4.8 — `MergePolicy` couldn't combine pages (e.g., `ConcatArray` but a page wasn't an array; `ConcatField` but the named field was missing).",
          "properties": {
            "MergeFailed": {
              "properties": {
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "reason"
              ],
              "type": "object"
            }
          },
          "required": [
            "MergeFailed"
          ],
          "type": "object"
        }
      ]
    },
    "BindingProtocol": {
      "enum": [
        "Cli",
        "Mcp",
        "AppFunction",
        "Rest"
      ],
      "type": "string"
    },
    "CliBindingConfig": {
      "description": "Canonical CLI binding config (SP-cli-binding-v2).\n\nAll fields except `cmd` are optional and use `skip_serializing_if` so existing `{\"cmd\": \"...\"}` configs from before SP-cli-binding-v2 still round-trip byte-identically.",
      "properties": {
        "args": {
          "description": "Fixed prefix arguments prepended to `args_template` expansion. Useful for subcommand routing (e.g. `[\"api\", \"v1\"]` so a tool always invokes `cmd api v1 <rendered template>`).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "args_template": {
          "description": "Templated argv tail. Placeholders are replaced before spawn:\n\n| Placeholder | Substitution | |---|---| | `{tool_id}` | ATD tool id, e.g. `mycli:gmail.users.messages.list` | | `{params_json}` | `RunTool.args` serialized as one JSON argv slot (quoting handled by the dispatcher) | | `{dry_run}` | Empty string when `dry_run=false`; the value of [`Self::dry_run_flag`] when `dry_run=true` | | `{page_all}` | Empty string normally; [`Self::page_all_flag`] when the dispatcher is fanning out for `call_all` |\n\nThe split between `cmd` + `args` (fixed) and `args_template` (per-call) lets servers reuse one binding for many tool ids by changing only the template. Servers are free to extend the placeholder vocabulary; consumers that don't recognize a placeholder should pass it through literally.",
          "type": [
            "string",
            "null"
          ]
        },
        "cmd": {
          "description": "Executable name or absolute path. Required.",
          "type": "string"
        },
        "dry_run_flag": {
          "description": "CLI-side flag passed when the ATD client sets `dry_run: true` on `RunTool`. Absent = tool doesn't expose dry-run; the dispatcher MUST reject the call rather than silently execute the side effect.",
          "type": [
            "string",
            "null"
          ]
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Environment variables injected into the spawned process.\n\nThe literal value `\"$ATD_BEARER\"` opts into bearer-token passthrough — the dispatcher replaces it with the connection's bearer (from the SP-12 `hello` handshake) at spawn time. Other `$NAME` syntax is not interpolated; values are passed verbatim.",
          "type": "object"
        },
        "exit_code_map": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Process exit-code → ATD `ToolResult.code` mapping for the error envelope. Codes not present in the map default to `\"TOOL_FAILED\"`; exit code 0 always succeeds and never consults the map. String values are domain-specific (e.g. `\"auth_required\"` for an OAuth refresh, `\"invalid_args\"` for CLI-side validation errors).",
          "type": "object"
        },
        "output_format": {
          "anyOf": [
            {
              "$ref": "#/definitions/CliOutputFormat"
            },
            {
              "type": "null"
            }
          ],
          "description": "How to parse the subprocess stdout into the `ToolResult.data` field. Defaults to [`CliOutputFormat::Json`] when absent."
        },
        "page_all_flag": {
          "description": "CLI-side flag the dispatcher appends when fanning out for `call_all` pagination. Absent = tool doesn't support pagination; the dispatcher MUST surface `call_page` / `call_all` requests as unsupported instead of silently calling the tool without paging.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "cmd"
      ],
      "type": "object"
    },
    "CliOutputFormat": {
      "description": "How to parse subprocess stdout into the ATD `ToolResult.data` payload.",
      "oneOf": [
        {
          "description": "stdout is a single JSON document. Default.",
          "enum": [
            "json"
          ],
          "type": "string"
        },
        {
          "description": "stdout is newline-delimited JSON. Each line becomes one page on the wire (when paginated) or is concatenated into a JSON array (when called as a single-shot tool).",
          "enum": [
            "ndjson"
          ],
          "type": "string"
        },
        {
          "description": "stdout is plain text lines. The dispatcher wraps the output as `{\"lines\": [...], \"stderr\": \"...\"}` for the `ToolResult.data` payload.",
          "enum": [
            "lines"
          ],
          "type": "string"
        }
      ]
    },
    "Request": {
      "description": "Request frames sent from client → server.",
      "oneOf": [
        {
          "properties": {
            "type": {
              "enum": [
                "ping"
              ],
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "SP-12 Hello handshake. Optional: pre-SP-12 servers do not recognize it; `AtdClient::hello` tolerates that and returns an empty granted set so callers can treat \"no capabilities\" and \"server too old\" identically.\n\nSP-capability-v2 (2026-05-11) adds the optional `ucan_tokens` field. When non-empty, each element is a UCAN-lite JWT compact form (`alg=EdDSA`, `typ=ucan/1.0+jwt`); the server's verifier produces `granted = granted_strings ∪ granted_ucan`. Pre-SP-capability-v2 servers omit the field via serde default; their behaviour is byte- identical to SP-12. Spec §4.2 + §5.2.",
          "properties": {
            "client_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "requested_capabilities": {
              "default": [],
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": {
              "enum": [
                "hello"
              ],
              "type": "string"
            },
            "ucan_tokens": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "enum": [
                "tool_list"
              ],
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "tool_id": {
              "type": "string"
            },
            "type": {
              "enum": [
                "tool_schema"
              ],
              "type": "string"
            }
          },
          "required": [
            "tool_id",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "args": true,
            "dry_run": {
              "type": "boolean"
            },
            "tool_id": {
              "type": "string"
            },
            "type": {
              "enum": [
                "run_tool"
              ],
              "type": "string"
            }
          },
          "required": [
            "args",
            "dry_run",
            "tool_id",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Fetch the next page of a paginated tool result. The cursor is the server-issued opaque string from a prior `Response::ToolResultResponse.next_cursor`. `tool_id` must match the cursor's embedded tool_id (server validates). SP-pagination-v1 §4.1.",
          "properties": {
            "cursor": {
              "type": "string"
            },
            "tool_id": {
              "type": "string"
            },
            "type": {
              "enum": [
                "run_tool_continue"
              ],
              "type": "string"
            }
          },
          "required": [
            "cursor",
            "tool_id",
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "Response": {
      "description": "Response frames sent from server → client.",
      "oneOf": [
        {
          "properties": {
            "type": {
              "enum": [
                "pong"
              ],
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "granted_capabilities": {
              "default": [],
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "server_version": {
              "default": "",
              "type": "string"
            },
            "supported_tiers": {
              "default": [],
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": {
              "enum": [
                "hello_ack"
              ],
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "tools": true,
            "type": {
              "enum": [
                "tool_list"
              ],
              "type": "string"
            }
          },
          "required": [
            "tools",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "schema": true,
            "type": {
              "enum": [
                "tool_schema"
              ],
              "type": "string"
            }
          },
          "required": [
            "schema",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "dry_run": {
              "type": "boolean"
            },
            "next_cursor": {
              "description": "SP-pagination-v1 §4.1 — when present, the tool has more pages. The client passes this verbatim to `Request::RunToolContinue.cursor` to fetch the next page. Server-opaque (HMAC-signed in the reference impl); clients MUST NOT parse it. Absent on terminal pages and on responses from non-paginating tools.",
              "type": [
                "string",
                "null"
              ]
            },
            "result": true,
            "success": {
              "type": "boolean"
            },
            "tool_id": {
              "type": "string"
            },
            "type": {
              "enum": [
                "tool_result"
              ],
              "type": "string"
            }
          },
          "required": [
            "dry_run",
            "result",
            "success",
            "tool_id",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "code": {
              "format": "uint16",
              "minimum": 0.0,
              "type": [
                "integer",
                "null"
              ]
            },
            "details": true,
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "type": {
              "enum": [
                "error"
              ],
              "type": "string"
            }
          },
          "required": [
            "message",
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "SafetyLevel": {
      "enum": [
        "Read",
        "Write",
        "Financial",
        "Privacy",
        "Physical",
        "Destructive"
      ],
      "type": "string"
    },
    "ToolBinding": {
      "properties": {
        "config": true,
        "protocol": {
          "$ref": "#/definitions/BindingProtocol"
        }
      },
      "required": [
        "config",
        "protocol"
      ],
      "type": "object"
    },
    "ToolCapability": {
      "properties": {
        "actions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "domain": {
          "type": "string"
        },
        "intent_examples": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "actions",
        "domain",
        "intent_examples",
        "tags"
      ],
      "type": "object"
    },
    "ToolDefinition": {
      "properties": {
        "bindings": {
          "items": {
            "$ref": "#/definitions/ToolBinding"
          },
          "type": "array"
        },
        "capability": {
          "$ref": "#/definitions/ToolCapability"
        },
        "description": {
          "type": "string"
        },
        "errors": {
          "default": [],
          "description": "Domain errors this tool may emit. Optional; missing on the wire = empty. Surfaces only via `describe`, never via `discover` (kept off `ToolSummary`).",
          "items": {
            "$ref": "#/definitions/ToolErrorDef"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "input_schema": true,
        "name": {
          "type": "string"
        },
        "output_schema": true,
        "required_capabilities": {
          "default": [],
          "description": "Capabilities a caller must hold for this tool to be invoked. Enforced by the server's dispatch layer (SP-12). Empty = unrestricted. The existing `capability` field above is a *descriptor* (domain, actions, intent examples); this is the *enforcement* list — intentionally separate to avoid overloading the schema.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "resources": {
          "$ref": "#/definitions/ToolResources"
        },
        "safety": {
          "$ref": "#/definitions/ToolSafety"
        },
        "tier": {
          "anyOf": [
            {
              "$ref": "#/definitions/ToolTier"
            },
            {
              "type": "null"
            }
          ],
          "description": "Execution tier hint used by the dispatch layer to derive deadline and max-output budgets. Absent / unknown values default to `Warm` on the server side (SP-12 back-compat). The client-facing `ToolSummary` carries an equivalent field."
        },
        "trust": {
          "$ref": "#/definitions/ToolTrust"
        },
        "version": {
          "type": "string"
        },
        "visibility": {
          "$ref": "#/definitions/ToolVisibility",
          "default": "read"
        }
      },
      "required": [
        "bindings",
        "capability",
        "description",
        "id",
        "input_schema",
        "name",
        "output_schema",
        "resources",
        "safety",
        "trust",
        "version"
      ],
      "type": "object"
    },
    "ToolErrorDef": {
      "properties": {
        "code": {
          "description": "SCREAMING_SNAKE error code, e.g. \"FILE_NOT_FOUND\".",
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "description",
        "retryable"
      ],
      "type": "object"
    },
    "ToolResources": {
      "properties": {
        "estimated_tokens": {
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_concurrent": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "rate_limit_per_min": {
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "timeout_ms": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "max_concurrent",
        "timeout_ms"
      ],
      "type": "object"
    },
    "ToolResult": {
      "oneOf": [
        {
          "properties": {
            "data": true,
            "metadata": {
              "$ref": "#/definitions/ToolResultMetadata"
            },
            "status": {
              "enum": [
                "success"
              ],
              "type": "string"
            }
          },
          "required": [
            "data",
            "metadata",
            "status"
          ],
          "type": "object"
        },
        {
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "retryable": {
              "type": "boolean"
            },
            "status": {
              "enum": [
                "error"
              ],
              "type": "string"
            }
          },
          "required": [
            "code",
            "message",
            "retryable",
            "status"
          ],
          "type": "object"
        }
      ]
    },
    "ToolResultMetadata": {
      "description": "Metadata attached to a successful tool result.\n\nOnly `tool_id` is required — servers always echo it. All other fields are server-populated and optional: clients must not synthesize them, because a fabricated `timestamp`/`request_id` would silently masquerade as server truth. `timestamp` and `request_id` are kept as opaque strings so this crate has no dependency on a specific datetime or ULID implementation; callers that need typed access can parse with their preferred library.",
      "properties": {
        "binding": {
          "anyOf": [
            {
              "$ref": "#/definitions/BindingProtocol"
            },
            {
              "type": "null"
            }
          ]
        },
        "latency_ms": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "request_id": {
          "description": "Opaque request identifier (ULID, UUID, or whatever the server emits).",
          "type": [
            "string",
            "null"
          ]
        },
        "timestamp": {
          "description": "ISO-8601 / RFC-3339 timestamp, server-populated.",
          "type": [
            "string",
            "null"
          ]
        },
        "tool_id": {
          "type": "string"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "tool_id"
      ],
      "type": "object"
    },
    "ToolSafety": {
      "properties": {
        "data_sensitivity": {
          "type": [
            "string",
            "null"
          ]
        },
        "dry_run": {
          "type": "boolean"
        },
        "level": {
          "$ref": "#/definitions/SafetyLevel"
        },
        "side_effects": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "dry_run",
        "level",
        "side_effects"
      ],
      "type": "object"
    },
    "ToolSummary": {
      "properties": {
        "description": {
          "type": "string"
        },
        "domain": {
          "default": "",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "input_schema": true,
        "name": {
          "default": "",
          "type": "string"
        },
        "tags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "tier": {
          "$ref": "#/definitions/ToolTier",
          "default": "warm"
        },
        "visibility": {
          "$ref": "#/definitions/ToolVisibility",
          "default": "read"
        }
      },
      "required": [
        "description",
        "id"
      ],
      "type": "object"
    },
    "ToolTier": {
      "enum": [
        "hot",
        "warm",
        "cold"
      ],
      "type": "string"
    },
    "ToolTrust": {
      "properties": {
        "publisher": {
          "type": "string"
        },
        "signature": {
          "items": {
            "format": "uint8",
            "minimum": 0.0,
            "type": "integer"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "trust_level": {
          "$ref": "#/definitions/TrustLevel"
        }
      },
      "required": [
        "publisher",
        "trust_level"
      ],
      "type": "object"
    },
    "ToolVisibility": {
      "oneOf": [
        {
          "enum": [
            "read",
            "write",
            "dangerous",
            "system"
